<Page x:Class="Sanatory.View.ServiceRequestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sanatory.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ServiceRequestPage" Style="{DynamicResource Page}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Заявка на доставку в номер" 
                   Style="{StaticResource Label}"
                   FontSize="16" FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <Label Content="Что хотите?" Style="{DynamicResource Label}"/>
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{DynamicResource TextBox}" 
                     Margin="0,0,0,10"/>

            <Label Content="Подробнее" Style="{DynamicResource Label}"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{DynamicResource TextBox}" 
                     Margin="0,0,0,10"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Height="80"/>

            <Button Content="Отправить заявку" 
                    Command="{Binding SubmitRequestCommand}"
                    Style="{DynamicResource Button}"
/>
        </StackPanel>
    </Grid>
</Page>