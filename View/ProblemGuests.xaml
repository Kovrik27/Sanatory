<Page x:Class="Sanatory.View.ProblemGuests"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sanatory.View"
      xmlns:vm="clr-namespace:Sanatory.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProblemGuests">
      
    <Page.Resources>
        <vm:ProblemGuestsVM x:Key="vm"/>
    </Page.Resources>
    
    <Grid>
        <StackPanel>
            <StackPanel DataContext="{Binding Problem}">
                <Label Content=" "/>
                <Label Content="Что сломалось?" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Description}" Style="{StaticResource TextBox}"/>
                <Label Content="Где сломалось?" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Place}" Style="{StaticResource TextBox}"/>
            </StackPanel>

            <Button Content="Отправить заявку" Command="{Binding Save}" Style="{StaticResource Button}"/>
        </StackPanel>
    </Grid>
</Page>
