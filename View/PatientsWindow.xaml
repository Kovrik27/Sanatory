<Window x:Class="Sanatory.View.PatientsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Sanatory.ViewModel"
        mc:Ignorable="d"
        DataContext="{DynamicResource ptWinVM}"
        Title="Кабинет пациента" Height="450" Width="800"
        WindowStartupLocation="CenterScreen" Style="{DynamicResource Window}">

    <Window.Resources>
        <vm:PatientWindowVM x:Key="ptWinVM"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Label Content="Кабинет пациента" 
                   Style="{StaticResource Label}"
                   FontSize="16" FontWeight="Bold"/>

            <Button Content="🏠 Главная" 
                    Style="{DynamicResource Button}"
                    Command="{Binding OpenHome}"
                    Margin="20,0,0,0"/>
            <Button Content="ℹ️ Информация" 
                    Style="{DynamicResource Button}"
                    Command="{Binding OpenInformation}"
                    Margin="10,0,0,0"/>
            <Button Content="📝 Заявка на поломку" 
                    Style="{DynamicResource Button}"
                    Command="{Binding OpenProblems}"
                    Margin="10,0,0,0"/>
            <Button Content="💬 Отзыв" 
                    Style="{DynamicResource Button}"
                    Command="{Binding OpenFeedbacks}"
                    Margin="10,0,0,0"/>
            <Button Content="Заявка на доп.услуги" 
        Style="{DynamicResource Button}"
        Command="{Binding OpenServiceRequest}"
        Margin="10,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="6" VerticalAlignment="Center">
            <Button Content="Выйти" Click="OutButton" Style="{DynamicResource ButtonOut}" Width="102"/>
        </StackPanel>

        <Frame x:Name="MainFrame" 
               Grid.Row="1" Grid.RowSpan="5"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>