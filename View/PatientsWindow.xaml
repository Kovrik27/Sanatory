<Window x:Class="Sanatory.View.PatientsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sanatory.View" 
        xmlns:vm="clr-namespace:Sanatory.ViewModel"
        mc:Ignorable="d"
        DataContext="{DynamicResource vm}"
        Title="PatientsWindow" Height="450" Width="800">

    <Window.Resources>
        <vm:PatientWindowVM x:Key="vm"/>
    </Window.Resources>

    <Grid>
        <Frame NavigationUIVisibility="Hidden" Grid.RowSpan="7" Grid.ColumnSpan="4" Background="AliceBlue"/>
        <Menu Grid.ColumnSpan="4" Style="{StaticResource Menu}">
            <MenuItem Header="Информация" Style="{StaticResource MenuItem}"/>
            <MenuItem Header="Процедуры" Style="{StaticResource MenuItem}"/>
        </Menu>
    </Grid>
</Window>
