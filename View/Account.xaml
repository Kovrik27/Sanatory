<Page x:Class="Sanatory.View.Account"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sanatory.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Account">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Label BorderThickness="2" Content="Логин"/>
            <TextBlock x:Name="userLogin"/>
            <TextBlock x:Name="userRole"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Label Content="ФИО"/>
            <TextBlock x:Name="userLastname"/>
            <TextBlock x:Name="userName"/>
            <TextBlock x:Name="userSurname"/>
            <Label Content="Данные"/>
            <TextBlock x:Name="userDataArrival"/>
            <TextBlock x:Name="userDataOfDeparture"/>
        </StackPanel>
    </Grid>
</Page>
