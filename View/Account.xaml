<Page x:Class="Sanatory.View.Account"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sanatory.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Account" Style="{DynamicResource Page}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Content="Это Ваш профиль!" HorizontalAlignment="Center" FontSize="20" Style="{DynamicResource Label}"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Label BorderThickness="2" Content="Логин:" FontSize="16" Style="{DynamicResource Label}"/>
            <TextBlock x:Name="userLogin" Style="{DynamicResource TextBlock}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Label Content="ФИО:" FontSize="16" Style="{DynamicResource Label}"/>
            <TextBlock x:Name="userLastname" Style="{DynamicResource TextBlock}"/>
            <TextBlock x:Name="userName" Style="{DynamicResource TextBlock}"/>
            <TextBlock x:Name="userSurname" Style="{DynamicResource TextBlock}"/>
        </StackPanel>
    </Grid>
</Page>
