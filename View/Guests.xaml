<Page x:Class="Sanatory.View.Guests"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sanatory.View"
      xmlns:vm="clr-namespace:Sanatory.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Guests" Style="{StaticResource Page}"
      DataContext="{DynamicResource guVM}">

    <Page.Resources>
        <vm:GuVM x:Key="guVM"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
            <Label Content="Поиск:" Style="{DynamicResource Label}" VerticalAlignment="Center"/>
            <TextBox Width="250" Height="30" Style="{DynamicResource TextBox}" 
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     Margin="10,0,0,0"/>
        </StackPanel>
        
        <Label Content="📋 Список гостей" Grid.Row="2" Grid.Column="0" 
               Style="{StaticResource Label}" Margin="0,10,0,0" FontSize="16"/>

        <Label Content="📝 Заявки на доп. услуги" Grid.Row="2" Grid.Column="1" 
               Style="{StaticResource Label}" Margin="10,10,0,0" FontSize="16"/>

        <ListView Grid.Row="3" Grid.Column="0" 
                  ItemsSource="{Binding Guests}" 
                  SelectedItem="{Binding SelectedGuest}" 
                  Style="{StaticResource ListView}"
                  Margin="0,5,5,0">
            <ListView.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Foreground" Value="#1B5E20"/>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Фамилия" DisplayMemberBinding="{Binding Surname}" 
                                    Width="120"
                                    HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                    <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding Name}" 
                                    Width="100"
                                    HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                    <GridViewColumn Header="Отчество" DisplayMemberBinding="{Binding Lastname}" 
                                    Width="120"
                                    HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                    <GridViewColumn Header="Заезд" DisplayMemberBinding="{Binding DataArrival, StringFormat=dd.MM.yyyy}" 
                                    Width="80"
                                    HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                    <GridViewColumn Header="Выезд" DisplayMemberBinding="{Binding DataOfDeparture, StringFormat=dd.MM.yyyy}" 
                                    Width="80"
                                    HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                    <GridViewColumn Header="№ Комнаты" DisplayMemberBinding="{Binding Room.Number}" 
                                    Width="80"
                                    HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                </GridView>
            </ListView.View>
        </ListView>
        
        <ListView Grid.Row="3" Grid.Column="1" 
                  ItemsSource="{Binding AllServices}" 
                  Style="{StaticResource ListView}"
                  Margin="10,5,0,0">
            <ListView.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Foreground" Value="#1B5E20"/>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Услуга" DisplayMemberBinding="{Binding Title}" 
                                    Width="150"
                                    HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                    <GridViewColumn Header="Описание" DisplayMemberBinding="{Binding Description}" 
                                    Width="200"
                                    HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                    <GridViewColumn Header="Гость" DisplayMemberBinding="{Binding Guest.Surname}" 
                                    Width="120"
                                    HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Menu Style="{StaticResource Menu}">
                <MenuItem Header="✏️ Изменить данные гостя" 
                          Command="{Binding EditGuests}" 
                          Style="{StaticResource MenuItem}"/>
            </Menu>

            <Button Content="📄 Экспорт карты в Word" 
                    Style="{DynamicResource Button}"
                    Command="{Binding ExportToWordCommand}"
                    Margin="20,0,0,0"
                    Padding="15,5"/>
        </StackPanel>
    </Grid>
</Page>