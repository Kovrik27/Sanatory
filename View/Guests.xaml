                        <GridViewColumn Header="Отчество гостя" DisplayMemberBinding="{Binding Lastname}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                        <GridViewColumn Header="Номер комнаты" DisplayMemberBinding="{Binding Room.Number}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                        <GridViewColumn Header="Дата заезда" DisplayMemberBinding="{Binding DataArrival}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                        <GridViewColumn Header="Дата выезда" DisplayMemberBinding="{Binding DataOfDeparture}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                        <GridViewColumn Header="Процедуры">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl DisplayMemberPath="Title" ItemsSource="{Binding Procedures}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>-->


        <StackPanel Grid.Row="4" DataContext="{DynamicResource guVM}">
            <Menu Style="{StaticResource Menu}">
                <MenuItem Header="Изменить данные или продлить бронь" Command="{Binding EditGuests}" Style="{StaticResource MenuItem}"/>
            </Menu>
        </StackPanel>
                      


        <!--<StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" DataContext="{DynamicResource guVM}">
            <Menu Style="{StaticResource Menu}">
                <MenuItem Header="Добавить гостю назначенную процедуру" Command="{Binding AddProcedure}" Style="{StaticResource MenuItem}"/>
            </Menu>
        </StackPanel>-->

    </Grid>
</Page>
