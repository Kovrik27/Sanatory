<Page x:Class="Sanatory.View.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sanatory.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="InventoryPage" Style="{DynamicResource Page}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Content=" "/>
        <Label Grid.Row="1" Content="Список материалов санатория" Style="{DynamicResource Label}"/>
        <Label Grid.Row="1" Grid.Column="1" Content="Список заявок" Style="{DynamicResource Label}"/>
        <ListView Grid.Row="2" Style="{DynamicResource ListBox}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Название"/>
                    <GridViewColumn Header="Сотрудник"/>
                    <GridViewColumn Header="Количество"/>
                </GridView>
            </ListView.View>
        </ListView>
        <ListView Grid.Row="2" Grid.Column="1" Style="{DynamicResource ListBox}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Номер"/>
                    <GridViewColumn Header="Название материала"/>
                    <GridViewColumn Header="Статус"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
