<Window x:Class="Sanatory.View.ProgWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sanatory.View"
        xmlns:vm="clr-namespace:Sanatory.ViewModel"
        mc:Ignorable="d"
        DataContext="{DynamicResource vm}"
        Title="ProgWindow" Height="450" Width="800">

    <Window.Resources>
        <vm:ProgVM x:Key="vm"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Frame NavigationUIVisibility="Hidden" Grid.RowSpan="7" Grid.ColumnSpan="4" Content="{Binding CurrentPage}"/>
        <Label Content=" "/>
        <Label Content=" " Grid.Row="1"/>
        <Label Content="Список тех.персонала" Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Center" Style="{StaticResource Label}"/>
        <Label Content="Список врачей" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" Style="{StaticResource Label}"/>
        <Label Content="Список гостей" Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="2" HorizontalAlignment="Center" Style="{StaticResource Label}"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
            <ListView ItemsSource="{Binding Staffs}" SelectedItem="{Binding SelectedStaff}" Style="{DynamicResource ListView}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Фамилия" DisplayMemberBinding="{Binding Lastname}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                        <GridViewColumn Header="Должность" DisplayMemberBinding="{Binding JobTitle.Title}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>


        <StackPanel Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2">
            <ListView ItemsSource="{Binding Staffs2}" SelectedItem="{Binding SelectedStaff}" Style="{StaticResource ListView}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Фамилия" DisplayMemberBinding="{Binding Lastname}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                        <GridViewColumn Header="Должность" DisplayMemberBinding="{Binding JobTitle.Title}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>

                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="4" Grid.ColumnSpan="2">
            <ListView ItemsSource="{Binding Staffs2}" SelectedItem="{Binding SelectedStaff}" Style="{StaticResource ListView}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Фамилия гостя" DisplayMemberBinding="{Binding Lastname }" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                        <GridViewColumn Header="Номер комнаты" DisplayMemberBinding="{Binding Room.Number}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
        <StackPanel Grid.Row="5"/>
        <Button Command="{Binding AddUserOn}"  Content="Назначить юзера" Grid.Column="4" Grid.ColumnSpan="2" Grid.Row="5" Style="{DynamicResource Button}" Margin="5,271,5,5"/>
    </Grid>
</Window>
