<Page x:Class="Sanatory.View.GuAdd"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sanatory.View"
      xmlns:c="clr-namespace:Sanatory.Converters"
      xmlns:vm="clr-namespace:Sanatory.ViewModel"
      DataContext="{DynamicResource guAddVM}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GuAdd" Style="{StaticResource Page}">

    <Page.Resources>
        <vm:GuAddVM x:Key="guAddVM"/>
        <c:InverseBooleanToVisibilityConverter x:Key="conv"/>
    </Page.Resources>
    <Grid>
        <ScrollViewer>
            <StackPanel>
                <Label Content=" "/>
                <StackPanel DataContext="{Binding Guest}">
                <Label Content="Фамилия гостя" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Lastname}" Style="{StaticResource TextBox}"/>
                <Label Content="Имя гостя" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Name}" Style="{StaticResource TextBox}"/>
                <Label Content="Отчество гостя" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Surname}" Style="{StaticResource TextBox}"/>
                <Label Content="Паспорт гостя" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Pasport}" Style="{StaticResource TextBox}"/>
                <Label Content="Полис гостя" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Policy}" Style="{StaticResource TextBox}"/>
                <Label Content="Дата заезда гостя" Style="{StaticResource Label}"/>
                <DatePicker SelectedDate="{Binding DataArrival}"/>
                <Label Content="Дата выезда гостя" Style="{StaticResource Label}"/>
                <DatePicker SelectedDate="{Binding DataOfDeparture}"/>
            </StackPanel>
            <StackPanel Margin="0,20,0,0">
                <Label Content="Выберите процедуры:" FontSize="16" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="200" Style="{StaticResource TextBox}" ToolTip="Поиск по названию или описанию"/>
                    <Button Content="Выбрать все" Command="{Binding SelectAllCommand}" Margin="10,0,5,0" Style="{StaticResource Button}"/>
                    <Button Content="Снять все" Command="{Binding DeselectAllCommand}" Style="{StaticResource Button}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <TextBlock Text="Выбрано процедур: " FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedProceduresCount}" Margin="5,0,20,0"/>
                    <TextBlock Text="Общая стоимость: " FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalProceduresPrice, StringFormat={}0:C}"/>
                </StackPanel>
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Procedures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" BorderBrush="LightGray" BorderThickness="0,0,0,1" >
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="400" Margin="0,2"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Длительность: " FontStyle="Italic"/>
                                                <TextBlock Text="{Binding Duration}" Margin="0,0,5,0"/>
                                                <TextBlock Text="мин." Margin="0,0,15,0"/>
                                                <TextBlock Text="Цена: " FontStyle="Italic"/>
                                                <TextBlock Text="{Binding Price}" Foreground="Green" FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
            <Button Content="Сохранить" Command="{Binding Save}" Margin="0,20" Style="{StaticResource Button}"/>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
