<Page x:Class="Sanatory.View.PrAddSt"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sanatory.View"
      xmlns:vm="clr-namespace:Sanatory.ViewModel"
      mc:Ignorable="d" 
      DataContext="{DynamicResource stVM}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PrAddSt" Style="{StaticResource Page}">
    <Page.Resources>
        <vm:StVM x:Key="stVM"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Content=" "/>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <Label Content="Сотрудник:" Style="{DynamicResource Label}"/>
            <TextBlock Text="{Binding SelectedStaff.Lastname}" Style="{DynamicResource TextBlock}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Label Content="Поиск" Style="{DynamicResource Label}"/>
            <TextBox Width="155" Height="30" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBox}"/>
        </StackPanel>
        <Label Grid.Row="2" Content="Выберите задачу, чтобы назначить её сотруднику" Style="{StaticResource Label}"/>
        <StackPanel Grid.Row="3" Grid.Column="1">
            <ListView x:Name="listProblems" ItemsSource="{Binding Problems}" SelectedItem="{Binding SelectedProblem}" Style="{StaticResource ListView}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Description}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Place}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
        <StackPanel Grid.Row="4" DataContext="{DynamicResource stVM}" >
            <Button Content="Назначить задачу" Command="{Binding AddProblemOnStaff}" CommandParameter="{Binding ElementName=listProblems, Path=SelectedItem}" Style="{StaticResource Button}"/>
        </StackPanel>
    </Grid>
</Page>
