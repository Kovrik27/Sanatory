<Page x:Class="Sanatory.View.Information"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sanatory.View"
      xmlns:vm="clr-namespace:Sanatory.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      DataContext="{DynamicResource infVM}"
      Title="Information" Style="{DynamicResource Page}">

    <Page.Resources>
        <vm:InformationVM x:Key="infVM"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content=" "/>
        <Label Grid.Row="1" Content="Выберите дату" FontSize="16" Style="{DynamicResource Label}"/>
        <Calendar Grid.Row="2" Style="{DynamicResource Calendar}" SelectedDate="{Binding SelectedDate, Mode=TwoWay}"/>
        <Label Grid.Column="1" Grid.Row="1" Content="Мероприятия" FontSize="16" Style="{DynamicResource Label}"/>
        <ListView Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Events}" Style="{DynamicResource ListView}" x:Name="EventsListView">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Title}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                    <GridViewColumn Header="Место" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                    <GridViewColumn Header="Время" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Button Click="GoBackOnPatientWindow" Grid.Column="1" Grid.Row="3" Content="Вернуться" Style="{DynamicResource Button}" VerticalAlignment="Bottom"/>
    </Grid> 
</Page>
