<Page x:Class="Sanatory.View.UsAdd"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sanatory.View"
      xmlns:vm="clr-namespace:Sanatory.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UsAdd" Style="{DynamicResource Page}">

    <Page.Resources>
        <vm:UsAddVM x:Key="usAddVM"/>
    </Page.Resources>
    <Grid>
        <StackPanel DataContext="{Binding User}">
            <Label Content=" "/>
            <Label Content="Введите логин" Style="{DynamicResource Label}"/>
            <TextBox Style="{DynamicResource TextBox}" Text="{Binding Login}"/>
            <Label Content="Введите пароль" Style="{DynamicResource Label}"/>
            <TextBox Style="{DynamicResource TextBox}" Text="{Binding Password}"/>
            <Label Content="Выберите роль" Style="{DynamicResource Label}"/>
            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding User.Role.Title}" Style="{DynamicResource ComboBox}"/>
            <Button Content="Сохранить" Style="{DynamicResource Button}" Command="{Binding Save}"/>
        </StackPanel>
    </Grid>
</Page>
