<Page x:Class="Sanatory.View.PrcAddGu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:Sanatory.ViewModel"
      xmlns:local="clr-namespace:Sanatory.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      DataContext="{DynamicResource guAddVM}"
      Title="PrcAddGu" Style="{StaticResource Page}">

    <Page.Resources>
        <vm:GuAddVM x:Key="guAddVM"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Content=" "/>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <Label Content="Гость:" Style="{DynamicResource Label}"/>
            <TextBlock Text="{Binding SelectedGuest.Lastname}" Style="{DynamicResource TextBlock}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Label Content="Поиск" Style="{DynamicResource Label}"/>
            <TextBox Width="155" Height="20" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBox}"/>
        </StackPanel>
        <Label Grid.Row="2" Content="Выберите процедуру, чтобы назначить её гостю" Style="{StaticResource Label}"/>
        <StackPanel Grid.Row="3">
            <ListView ItemsSource="{Binding Procedures}" SelectedItem="{Binding SelectedProcedure}" Style="{StaticResource ListView}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Title}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}" />
                        <GridViewColumn DisplayMemberBinding="{Binding Description}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Duration}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Price}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
       
        <StackPanel Grid.Row="4" DataContext="{DynamicResource guAddVM}" >
            <Button Content="Назначить процедуры" Command="{Binding AddPrc}" Style="{StaticResource Button}" />
        </StackPanel>
    </Grid>
</Page>
