<Page x:Class="Sanatory.View.EvAddDay"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Sanatory.View"
      xmlns:vm="clr-namespace:Sanatory.ViewModel"
      mc:Ignorable="d" 
      DataContext="{DynamicResource daysTimeAddVM}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EvAddDay" Style="{StaticResource Page}">

    <Page.Resources>
        <vm:DaysTimAddVM x:Key="daysTimeAddVM"/>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Content=" "/>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <Label Content="Дата:" Style="{DynamicResource Label}"/>
            <TextBlock Text="{Binding SelectedDaytime.Time}" Style="{DynamicResource TextBlock}"/>
        </StackPanel>
        <Label Grid.Row="2" Content="Выберите мероприятие, чтобы внести его в расписание дня" Style="{StaticResource Label}"/>
        <StackPanel Grid.Row="3" Grid.Column="1">
            <ListView ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" Style="{StaticResource ListView}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Title}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Times}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Place}" HeaderContainerStyle="{DynamicResource ListViewColumnHeader}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
        <StackPanel Grid.Row="4" DataContext="{DynamicResource daysTimeAddVM}" >
            <Button Content="Добавить мероприятие" Command="{Binding AddEvent}" CommandParameter="{Binding ElementName=listEvent, Path=SelectedItem}" Style="{StaticResource Button}"/>
        </StackPanel>
    </Grid>
</Page>
