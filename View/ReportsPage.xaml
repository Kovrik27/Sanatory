<Page x:Class="Sanatory.View.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Sanatory.Converters"
      xmlns:vm="clr-namespace:Sanatory.ViewModel"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Отчеты"
      DataContext="{DynamicResource rpVM}"
      Style="{StaticResource Page}">

    <Page.Resources>
        <local:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <vm:RpVM x:Key="rpVM"/>
    </Page.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content=" "/>
        <StackPanel Grid.Row="1" Margin="0,0,0,5">
            <TextBlock Text="Отчеты санатория" 
                       Style="{StaticResource TextBlock}"
                       FontSize="16" 
                       FontWeight="Bold" 
                       Margin="0,0,0,5"/>

            <WrapPanel>
                <RadioButton Content="Проживание" 
                             IsChecked="{Binding SelectedReportType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=accommodation}"
                             GroupName="ReportType"
                             Margin="0,0,10,3"/>
                <RadioButton Content="Процедуры" 
                             IsChecked="{Binding SelectedReportType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=procedures}"
                             GroupName="ReportType"
                             Margin="0,0,10,3"/>
                <RadioButton Content="Финансовый" 
                             IsChecked="{Binding SelectedReportType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=financial}"
                             GroupName="ReportType"
                             Margin="0,0,15,3"/>
            </WrapPanel>

            <WrapPanel Margin="0,3,0,0">
                <TextBlock Text="Период:" Style="{StaticResource TextBlock}" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <DatePicker SelectedDate="{Binding StartDate}" 
                            Style="{StaticResource DatePicker}"/>
                <TextBlock Text="-" Style="{StaticResource TextBlock}" FontSize="12" VerticalAlignment="Center" Margin="0,0,3,0"/>
                <DatePicker SelectedDate="{Binding EndDate}" 
                            Style="{StaticResource DatePicker}"/>
                <Button Content="Сформировать" 
                        Style="{StaticResource Button}"
                        Command="{Binding GenerateReportCommand}"
                        Margin="5,0,0,0"/>
                <Button Content="📊 Экспорт Excel" 
                        Style="{StaticResource Button}"
                        Command="{Binding ExportToExcelCommand}"
                        Margin="5,0,0,0"/>
            </WrapPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

            <StackPanel>
                <Border Visibility="{Binding SelectedReportType, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=accommodation}">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <Border Background="#4CAF50" CornerRadius="3" Padding="8" Margin="2" Width="130">
                                <StackPanel>
                                    <TextBlock Text="Доход" FontSize="9" Foreground="White"/>
                                    <TextBlock Text="{Binding AccommodationReport.Summary.TotalIncome, StringFormat={}{0:N2} руб.}" 
                                               FontSize="12" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#2196F3" CornerRadius="3" Padding="8" Margin="2" Width="130">
                                <StackPanel>
                                    <TextBlock Text="Загрузка" FontSize="9" Foreground="White"/>
                                    <TextBlock Text="{Binding AccommodationReport.Summary.OccupancyRate, StringFormat={}{0:F1}%}" 
                                               FontSize="12" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FF9800" CornerRadius="3" Padding="8" Margin="2" Width="130">
                                <StackPanel>
                                    <TextBlock Text="Гостей" FontSize="9" Foreground="White"/>
                                    <TextBlock Text="{Binding AccommodationReport.Summary.TotalGuests}" 
                                               FontSize="12" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="Детализация проживания" Style="{StaticResource TextBlock}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ListView ItemsSource="{Binding AccommodationReport.Details}" Style="{StaticResource ListView}">
                            <ListView.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="16"/>
                                    <Setter Property="Foreground" Value="#1B5E20"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Гость" DisplayMemberBinding="{Binding GuestName}" Width="150"/>
                                    <GridViewColumn Header="№" DisplayMemberBinding="{Binding RoomNumber}" Width="35"/>
                                    <GridViewColumn Header="Заезд" DisplayMemberBinding="{Binding CheckInDate, StringFormat={}dd.MM}" Width="55"/>
                                    <GridViewColumn Header="Выезд" DisplayMemberBinding="{Binding CheckOutDate, StringFormat={}dd.MM}" Width="55"/>
                                    <GridViewColumn Header="Ночей" DisplayMemberBinding="{Binding Nights}" Width="45"/>
                                    <GridViewColumn Header="Сумма" DisplayMemberBinding="{Binding TotalCost, StringFormat={}{0:N2} руб.}" Width="70"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <TextBlock Text="Загрузка номеров" Style="{StaticResource TextBlock}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <ListView ItemsSource="{Binding AccommodationReport.RoomStats}" Style="{StaticResource ListView}">
                            <ListView.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="16"/>
                                    <Setter Property="Foreground" Value="#1B5E20"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Номер" DisplayMemberBinding="{Binding RoomNumber}" Width="45"/>
                                    <GridViewColumn Header="Тип" DisplayMemberBinding="{Binding RoomType}" Width="80"/>
                                    <GridViewColumn Header="Занято дней" DisplayMemberBinding="{Binding OccupiedDays}" Width="70"/>
                                    <GridViewColumn Header="%" DisplayMemberBinding="{Binding OccupancyPercentage, StringFormat={}{0:F1}%}" Width="50"/>
                                    <GridViewColumn Header="Доход" DisplayMemberBinding="{Binding TotalIncome, StringFormat={}{0:N2} руб.}" Width="70"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Visibility="{Binding SelectedReportType, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=procedures}">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <Border Background="#9C27B0" CornerRadius="3" Padding="8" Margin="2" Width="130">
                                <StackPanel>
                                    <TextBlock Text="Доход" FontSize="9" Foreground="White"/>
                                    <TextBlock Text="{Binding ProcedureReport.Summary.TotalIncome, StringFormat={}{0:N2} руб.}" 
                                               FontSize="12" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#E91E63" CornerRadius="3" Padding="8" Margin="2" Width="130">
                                <StackPanel>
                                    <TextBlock Text="Процедур" FontSize="9" Foreground="White"/>
                                    <TextBlock Text="{Binding ProcedureReport.Summary.TotalProcedures}" 
                                               FontSize="12" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#00BCD4" CornerRadius="3" Padding="8" Margin="2" Width="130">
                                <StackPanel>
                                    <TextBlock Text="На гостя" FontSize="9" Foreground="White"/>
                                    <TextBlock Text="{Binding ProcedureReport.Summary.ProceduresPerGuest}" 
                                               FontSize="12" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="Популярность процедур" Style="{StaticResource TextBlock}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ListView ItemsSource="{Binding ProcedureReport.Popularity}" Style="{StaticResource ListView}" MaxHeight="150">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Процедура" DisplayMemberBinding="{Binding ProcedureName}" Width="130"/>
                                    <GridViewColumn Header="Выполнено" DisplayMemberBinding="{Binding TimesPerformed}" Width="60"/>
                                    <GridViewColumn Header="Доход" DisplayMemberBinding="{Binding TotalIncome, StringFormat={}{0:N2} руб.}" Width="70"/>
                                    <GridViewColumn Header="%" DisplayMemberBinding="{Binding PopularityPercent, StringFormat={}{0:F1}%}" Width="50"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <TextBlock Text="Последние процедуры" Style="{StaticResource TextBlock}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <ListView ItemsSource="{Binding ProcedureReport.Details}" Style="{StaticResource ListView}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding ServiceDate, StringFormat={}dd.MM HH:mm}" Width="70"/>
                                    <GridViewColumn Header="Гость" DisplayMemberBinding="{Binding GuestName}" Width="120"/>
                                    <GridViewColumn Header="Процедура" DisplayMemberBinding="{Binding ProcedureName}" Width="120"/>
                                    <GridViewColumn Header="Врач" DisplayMemberBinding="{Binding DoctorName}" Width="100"/>
                                    <GridViewColumn Header="Сумма" DisplayMemberBinding="{Binding TotalCost, StringFormat={}{0:N2} руб.}" Width="70"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Visibility="{Binding SelectedReportType, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=financial}">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <Border Background="#F44336" CornerRadius="3" Padding="6" Margin="2" Width="110">
                                <StackPanel>
                                    <TextBlock Text="Всего" FontSize="8" Foreground="White"/>
                                    <TextBlock Text="{Binding FinancialReport.Summary.TotalIncome, StringFormat={}{0:N0} руб.}" 
                                               FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#4CAF50" CornerRadius="3" Padding="6" Margin="2" Width="100">
                                <StackPanel>
                                    <TextBlock Text="Прожив." FontSize="8" Foreground="White"/>
                                    <TextBlock Text="{Binding FinancialReport.Summary.AccommodationIncome, StringFormat={}{0:N0} руб.}" 
                                               FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding FinancialReport.Summary.AccommodationPercent, StringFormat={}{0:F0}%}" 
                                               FontSize="8" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#9C27B0" CornerRadius="3" Padding="6" Margin="2" Width="100">
                                <StackPanel>
                                    <TextBlock Text="Проц." FontSize="8" Foreground="White"/>
                                    <TextBlock Text="{Binding FinancialReport.Summary.ProceduresIncome, StringFormat={}{0:N0} руб.}" 
                                               FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding FinancialReport.Summary.ProceduresPercent, StringFormat={}{0:F0}%}" 
                                               FontSize="8" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FF9800" CornerRadius="3" Padding="6" Margin="2" Width="110">
                                <StackPanel>
                                    <TextBlock Text="Ср. чек" FontSize="8" Foreground="White"/>
                                    <TextBlock Text="{Binding FinancialReport.Summary.AverageGuestSpending, StringFormat={}{0:N0} руб.}" 
                                               FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="Топ гостей" Style="{StaticResource TextBlock}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ListView ItemsSource="{Binding FinancialReport.TopSpenders}" Style="{StaticResource ListView}" MaxHeight="120">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Гость" DisplayMemberBinding="{Binding GuestName}" Width="150"/>
                                    <GridViewColumn Header="№" DisplayMemberBinding="{Binding RoomNumber}" Width="35"/>
                                    <GridViewColumn Header="Прожив." DisplayMemberBinding="{Binding AccommodationCost, StringFormat={}{0:N2} руб.}" Width="70"/>
                                    <GridViewColumn Header="Проц." DisplayMemberBinding="{Binding ProceduresCost, StringFormat={}{0:N2} руб.}" Width="70"/>
                                    <GridViewColumn Header="Всего" DisplayMemberBinding="{Binding TotalSpent, StringFormat={}{0:N2} руб.}" Width="80"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <TextBlock Text="По месяцам" Style="{StaticResource TextBlock}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <ListView ItemsSource="{Binding FinancialReport.MonthlyComparison}" Style="{StaticResource ListView}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Месяц" DisplayMemberBinding="{Binding Month}" Width="70"/>
                                    <GridViewColumn Header="Прожив." DisplayMemberBinding="{Binding AccommodationIncome, StringFormat={}{0:N2} руб.}" Width="80"/>
                                    <GridViewColumn Header="Проц." DisplayMemberBinding="{Binding ProceduresIncome, StringFormat={}{0:N2} руб.}" Width="80"/>
                                    <GridViewColumn Header="Всего" DisplayMemberBinding="{Binding TotalIncome, StringFormat={}{0:N2} руб.}" Width="90"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" 
                Background="#E8F5E9" 
                CornerRadius="3" 
                Padding="5"
                Margin="0,5,0,0"
                BorderBrush="#388E3C"
                BorderThickness="1">
            <WrapPanel HorizontalAlignment="Right">
                <TextBlock Text="Период:" Style="{StaticResource TextBlock}" FontWeight="Bold" FontSize="10" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding PeriodDisplay}" Style="{StaticResource TextBlock}" FontSize="10" FontStyle="Italic"/>
            </WrapPanel>
        </Border>
    </Grid>
</Page>